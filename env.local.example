# Upstash Redis connection details
# Both naming conventions are supported for backward compatibility
UPSTASH_REDIS_REST_URL="your_upstash_redis_url_here"
UPSTASH_REDIS_REST_TOKEN="your_upstash_redis_token_here"
KV_REST_API_URL="your_upstash_redis_url_here"
KV_REST_API_TOKEN="your_upstash_redis_token_here"

# Alpha Vantage API key for market data
ALPHA_VANTAGE_API_KEY="your_alpha_vantage_api_key_here"

# Anthropic (Claude) API key for AI features
ANTHROPIC_API_KEY="your_anthropic_api_key_here"

# Allowed origins for API access (comma-separated list, no spaces)
# Add your deployed URL here if you host it, e.g. https://my-terminal.vercel.app,http://localhost:3000
ALLOWED_ORIGINS="http://localhost:3000"
